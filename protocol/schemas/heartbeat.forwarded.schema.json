{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heartbeat.forwarded.schema.json",
  "title": "heartbeat.forwarded",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "heartbeat_seq",
    "lease_id"
  ],
  "properties": {
    "v": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "type": {
      "const": "heartbeat"
    },
    "heartbeat_seq": {
      "$ref": "common.schema.json#/$defs/counter"
    },
    "lease_id": {
      "$ref": "common.schema.json#/$defs/id"
    }
  }
}
