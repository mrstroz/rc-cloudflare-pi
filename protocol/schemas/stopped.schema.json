{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stopped.schema.json",
  "title": "stopped",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "request_id",
    "cause"
  ],
  "properties": {
    "v": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "type": {
      "const": "stopped"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "cause": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/stop_cause"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
