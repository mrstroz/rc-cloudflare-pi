{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error.schema.json",
  "title": "error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "reason",
    "request_id"
  ],
  "properties": {
    "v": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "type": {
      "const": "error"
    },
    "reason": {
      "$ref": "common.schema.json#/$defs/error_reason"
    },
    "request_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
