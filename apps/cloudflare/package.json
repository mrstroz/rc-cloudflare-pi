{
  "name": "rc-cloudflare",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "dev": "pnpm build && node scripts/dev.ts",
    "test": "pnpm build && vitest run",
    "typecheck": "wrangler types --check && vue-tsc --build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "jose": "6.2.14",
    "vue": "3.5.44"
  }
}
